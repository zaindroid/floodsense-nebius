{
  "name": "floodsense-engines",
  "version": "0.1.0",
  "private": true,
  "description": "FloodSense sidecar: Meterless H-MEM (memory + trust ledger) and World Model (hypothesis board + event log) over HTTP for the agents.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --experimental-transform-types --no-warnings src/main.ts",
    "test": "node --experimental-transform-types --no-warnings --test test/floodsense.test.ts test/server.test.ts",
    "conformance": "node --experimental-transform-types --no-warnings scripts/conformance.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "typescript": "6.0.3"
  }
}
