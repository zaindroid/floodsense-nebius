# engines/.env.example: the H-MEM and World Model sidecar.
# python tasks.py init-env copies this to engines/.env (git-ignored); npm start
# reads engines/.env when it exists. The defaults below work as they are.
# Needs Node.js 22.18 or newer.
# No secrets belong here: the service has no keys and no authentication.

# Bind address. Keep 127.0.0.1 on a laptop; 0.0.0.0 only inside a container.
ENGINES_HOST=127.0.0.1
# Port the agents call.
ENGINES_PORT=8300
# Where memories, the trust ledger and the World Model event log are kept,
# relative to engines/. "memory" keeps nothing on disk.
ENGINES_DATA_DIR=.data

# How the agents find this service: ENGINES_URL in the agents' env.
#   agents run on the host:              ENGINES_URL=http://127.0.0.1:8300
#   agents run in compose (this stack):  ENGINES_URL=http://engines:8300
# compose.yaml sets the compose value on the agents service. It also forces
# ENGINES_HOST=0.0.0.0, ENGINES_PORT=8300, and ENGINES_DATA_DIR=/data inside
# the engines container, and publishes the host port on 127.0.0.1 only.
