# Copy to api/.env. Placeholders only. Never commit the copy.
#
# The NVIDIA provider key is not an application environment variable.
# It lives only in Nightshift's Providers tab.

# The image listens on 8000 (api/Dockerfile). These two variables are not
# read yet. The published host port is FLOODSENSE_API_PORT in the root .env.
API_HOST=0.0.0.0
API_PORT=8000

# Inside Compose this is the agent service DNS name. Compose also sets it.
# On the host, run `python -m floodsense_agents` and use http://127.0.0.1:8100.
# Port 8100 is not published.
AGENTS_URL=http://agents:8100
# Browser origins allowed by CORS (comma-separated). The UI dev server and the compose UI port.
UI_ORIGINS=http://localhost:15173,http://127.0.0.1:15173

# Cache and labelled replay (app/cache.py, GAMEPLAN "Caching and the honest
# demo"). Both stay off until their flag is on here. A cached answer is a
# person-approved, Judge-passed run; a replay is served only when the live run
# fails. Both are labelled "not live" with the original run's time.
FF_SEMANTIC_CACHE=false
FF_CACHED_REPLAY=false
# Seconds a cached answer stays valid: live data, then a historical replay.
CACHE_TTL_LIVE_S=900
CACHE_TTL_REPLAY_S=86400
CACHE_MAX_ENTRIES=256
# Cache and replay lookups (the flag fingerprint, GET /runs/{id}, GET /runs/past).
# Not the 600s a live run may take. When the agents cannot be reached, the API
# serves an in-process recording instead of waiting.
CACHE_LOOKUP_TIMEOUT_S=3
# Recordings the API keeps itself, so a replay works with the agents down.
REPLAY_MAX_RECORDINGS=8

# Rate limits (app/ratelimit.py). POST /runs has a token bucket per client IP
# (approval is not limited); live runs in flight are capped. Both answer 429 with
# Retry-After. 0 turns a guard off. GET routes are never limited.
RATE_LIMIT_RUNS_PER_MIN=10
RATE_LIMIT_MAX_CONCURRENT_RUNS=2
RATE_LIMIT_CONCURRENCY_RETRY_AFTER_S=30

# This file is the source of truth under Compose. Do not also set it in the
# root .env. Empty -> in-process cache. Set -> cache entries and replay recordings
# also go to Redis with native TTLs; if Redis is down the API falls back to memory.
# With the cache profile:
# REDIS_URL=redis://redis:6379/0
REDIS_URL=
# Lifetime of a replay recording in Redis (30 days).
REPLAY_RECORDING_TTL_S=2592000
