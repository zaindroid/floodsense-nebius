# Copy to ui/.env. Vite exposes VITE_* values to the browser.
# Do not put Zetaris keys, the Nightshift token, or any other secret here.
#
# The NVIDIA provider key is not an application environment variable.
# It lives only in Nightshift's Providers tab.

VITE_API_URL=http://localhost:18000

# Optional probe timeout in milliseconds. Unset uses 10000.
# VITE_API_TIMEOUT_MS=10000

# Optional recorded agent run for the Ask FloodSense popup, read from GET /runs/{id}/replay.
# It is always labelled a replay, never live. Unset, or any fetch failure, keeps the fixture answer.
# VITE_REPLAY_RUN_ID=f16733274f1c
