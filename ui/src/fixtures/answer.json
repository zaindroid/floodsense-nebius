  "question": "Why is the Paiporta point (VAL01) showing a modelled discharge peak around 29–30 Oct 2024?",
  "claims": [
    {
      "claim_id": "claim_val01_rain",
      "text": "In floodsense_seed.hazard_timeline, VAL01 hourly rain on 29 Oct 2024 peaks at 16.4 mm at 12:00 UTC. warning_level is null. Joined discharge that hour is 31.06 m³/s."
    },
    {
      "claim_id": "claim_val07",
      "text": "VAL07 discharge in floodsense_seed.discharge_daily is 0.62 m³/s on 29 Oct 2024 and 45.99 m³/s on 30 Oct 2024. The source column is seed:open-meteo-flood-glofas."
    },
    {
      "claim_id": "claim_val01_peak",
      "text": "On 30 Oct 2024, floodsense_seed.discharge_daily lists 467.81 m³/s at VAL01. The source column is seed:open-meteo-flood-glofas. From 20 Oct through 27 Oct the same point stays between 5.27 and 11.02 m³/s."
    },
    {
      "claim_id": "claim_grid",
      "text": "VAL01 and VAL02 list the same discharge_m3s on every date in this seed extract, including 467.81 m³/s on 30 Oct 2024."
    }
  ],
