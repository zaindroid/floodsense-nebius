# agents/.env.example — copy to agents/.env and fill in locally. Never commit .env.
# Placeholders only.
#
# The NVIDIA chat key is not an application environment variable.
# It lives only in Nightshift's Providers tab. Do not add that key here.
# NVIDIA_NIM_API_KEY below is only the document-embedding exception (ADR 0009).
#
# From this container, 127.0.0.1 is the container. Use host.docker.internal.
# Nightshift headers on every call:
#   Authorization: Bearer <METERLESS_RUNTIME_TOKEN>
#   meterless-app: <METERLESS_APP>
#   meterless-scope: user

ZETARIS_REST_URL=http://host.docker.internal:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=
ZETARIS_JDBC_URL=
ZETARIS_USER=
ZETARIS_PASSWORD=

METERLESS_BASE_URL=http://host.docker.internal:8088/v1
METERLESS_APP=floodsense-eu
METERLESS_SCOPE=user
METERLESS_RUNTIME_TOKEN=

# Routing modes. These two values are what the app sends. Nightshift picks
# the model: Nemotron 3.5 Lightning 30B A3B on both lanes in the 27 Oct runs. Neither is the value of MODEL_FAST. The model that answered is logged on
# the trace. The one map from mode to model id is in docs/architecture/c4.md.
MODEL_FAST=meterless/fast
MODEL_DEEP=meterless/deep

# LLM backend: nightshift (default) | nebius (Nebius Token Factory, NVIDIA Nemotron).
# With nebius, NEBIUS_API_KEY is required (startup fails without it); MODEL_FAST/MODEL_DEEP are ignored.
LLM_BACKEND=nightshift
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL_FAST=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEBIUS_MODEL_DEEP=nvidia/Nemotron-3.5-Super-VL
# Total budget per model call, in seconds: the wait for a Nightshift slot,
# every attempt and every backoff sleep all come out of it.
LLM_TIMEOUT_S=180
# Retry policy: a timeout, or an error after LLM_SLOW_FAIL_S seconds (the
# gateway's ~45 s 502 on long generations), is never retried. Other errors
# get LLM_MAX_ATTEMPTS tries in total.
LLM_SLOW_FAIL_S=20
LLM_MAX_ATTEMPTS=2
# Runaway caps on completion tokens. Nemotron's hidden reasoning counts here.
LLM_MAX_TOKENS_FAST=6000
LLM_MAX_TOKENS_DEEP=8000
# Concurrent model calls in one node (Skeptic rationales, Judge grounding).
LLM_MAX_PARALLEL=6
# Process-wide guard for NVIDIA's 40 requests/min per key: at most this many
# Nightshift calls in flight, and call starts paced to NIGHTSHIFT_RPM per
# minute (0 = no pacing). Rate limits and empty responses retry with backoff.
NIGHTSHIFT_MAX_CONCURRENCY=3
NIGHTSHIFT_RPM=35
# false: no repair round when the Judge already passes the run.
JUDGE_REPAIR_WHEN_PASSING=false
PGVECTOR_DSN=
# Document embeddings. Leave both empty in git. Fill NVIDIA_NIM_API_KEY only in
# the gitignored agents/.env. NIM_EMBEDDINGS_URL may replace the default NIM URL.
NVIDIA_NIM_API_KEY=
NIM_EMBEDDINGS_URL=

# Engines sidecar (engines/: H-MEM and the World Model). Empty = off, and the
# graph runs as before. compose.yaml sets ENGINES_URL=http://engines:8300 on
# the agents service, which wins over this file. On the host, with the sidecar
# published on loopback, use http://127.0.0.1:8300. FF_HMEM below also needs
# this URL. The client is floodsense_agents/engines.py.
ENGINES_URL=
ENGINES_TIMEOUT_S=5
HMEM_RECALL_TOP_N=3
# Recall keeps past findings on the same event. Raise the threshold (0 to 1)
# once the engines embed with a real model; their reference hash cannot tell
# a related question from an unrelated one.
HMEM_RECALL_THRESHOLD=0

# Runtime switches. auto = live when the URL above is set, otherwise the
# offline stand-ins FakeZetaris and FakeNightshift. Use `fake` to force
# offline, or `live` to refuse to start without credentials.
ZETARIS_MODE=auto
# Independent SELECTs one node may run at once. 8 covers Watchers, the
# Investigator aggregates, and the Exposure join. 1 runs them in call order,
# one at a time.
ZETARIS_MAX_PARALLEL=8
LLM_MODE=auto
# HITL checkpointer: sqlite under CHECKPOINT_DIR, memory fallback with a
# warning. CHECKPOINTER=sqlite refuses the fallback.
CHECKPOINTER=auto
CHECKPOINT_DIR=/data/checkpoints
# Counter-checks per hypothesis. Default 3. A smoke run can set this to 1
# to skip the later checks. The graph reads this setting; it does not hardcode 1.
SKEPTIC_MAX_ROUNDS=3
JUDGE_REPAIR_ROUNDS=1
JUDGE_MIN_SCORE=0.7
NUMERIC_TOLERANCE=0.02

# Feature flags. v1.0 defaults are in docs/GAMEPLAN.md.
# FF_SKEPTIC, FF_HITL and FF_JUDGE are implemented and on, matching the v1.0
# defaults. FF_LIVE_DATA switches from floodsense_seed.* to floodsense.* and
# defaults false, the same as settings.live_data. Leave it false unless you
# mean to read the live schema. The rest stay off because that behaviour does
# not exist yet. Host sync credentials belong in ingestion/.env.
# 0.0.0.0 because compose and the image reach this from outside the
# container. A bare host process does not need it; override to 127.0.0.1.
AGENTS_HOST=0.0.0.0

FF_LIVE_DATA=false
FF_SKEPTIC=true
FF_HITL=true
FF_HMEM=false
FF_JUDGE=true
FF_RAG_DOCS=false
# Tavily web context: cited, labelled "Web context, not an official warning". Off by default.
FF_TAVILY=false
TAVILY_API_KEY=
TAVILY_TIMEOUT_S=6
FF_SEMANTIC_CACHE=false
FF_CACHED_REPLAY=false
FF_EFAS=false
FF_EXTRA_SEGMENTS=false

# Control tower (agents/README.md "Control tower"). The watch loop is rule-based: no model calls.
FF_WATCH_LOOP=true
# Each scan costs about 19 Open-Meteo location-calls (eu_watch 11 + hazard_now 8): 900 s is about 1,800 a day
# against a free-tier budget of about 10,000. A scan with a new raised source adds 45 (weather_forecast).
WATCH_INTERVAL_S=900
# Auto-assess starts ONE full run (model calls) for the worst new source; capped; never approves anything.
FF_AUTO_ASSESS=false
# Required to change the auto-assess switch when set (header x-watch-admin-token). SET THIS outside the dev machine.
# WATCH_ADMIN_TOKEN=
WATCH_AUTO_PER_HOUR=1
WATCH_AUTO_PER_DAY=3
# Event history (JSONL) and last statuses; default: a "watch" folder beside the checkpoints.
# WATCH_DATA_DIR=/data/checkpoints/watch
